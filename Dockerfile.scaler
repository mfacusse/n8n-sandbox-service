FROM golang:1.25-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/scaler ./cmd/scaler

FROM alpine:3.23

RUN apk add --no-cache tini ca-certificates

COPY --from=builder /out/scaler /usr/local/bin/sandbox-scaler

RUN addgroup -S sandbox-scaler && adduser -S -G sandbox-scaler sandbox-scaler

ENV SANDBOX_SCALER_LISTEN_ADDR=:8090

EXPOSE 8090

USER sandbox-scaler:sandbox-scaler

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/sandbox-scaler"]
